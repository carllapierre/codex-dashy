# Port exposed on the host for the Docker container.
HOST_PORT=8789

# Port used by the Node API inside the container.
PORT=8789

# Address used by the Node server. Keep 0.0.0.0 for Docker.
HOST=0.0.0.0

# SQLite database path inside the container.
DB_FILE=/app/data/codex-dashy.db

# Allowed browser origin for local development.
CORS_ORIGIN=http://localhost:5173

# Local HTTP bridge that owns the authenticated Codex app-server process.
CODEX_USAGE_BRIDGE_URL=http://127.0.0.1:8790
